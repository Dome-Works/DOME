<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <Target Name="CopyCytoscapeAssets" BeforeTargets="Build">
    <PropertyGroup>
      <_CytoscapeSource>$(MSBuildProjectDirectory)/node_modules/cytoscape/dist/cytoscape.esm.min.mjs</_CytoscapeSource>
      <_CytoscapeDestDir>$(MSBuildProjectDirectory)/wwwroot/lib/cytoscape</_CytoscapeDestDir>
      <_CytoscapeDest>$(_CytoscapeDestDir)/cytoscape.esm.min.js</_CytoscapeDest>
    </PropertyGroup>

    <MakeDir Directories="$(_CytoscapeDestDir)" Condition="Exists('$(_CytoscapeSource)')" />
    <Copy
      Condition="Exists('$(_CytoscapeSource)')"
      SourceFiles="$(_CytoscapeSource)"
      DestinationFiles="$(_CytoscapeDest)"
      SkipUnchangedFiles="true" />

    <Error
      Condition="!Exists('$(_CytoscapeDest)')"
      Text="Cytoscape.js was not found at $(_CytoscapeDest). Run 'npm install' in $(MSBuildProjectDirectory) before building." />
  </Target>

</Project>
