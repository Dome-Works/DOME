@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using HomelabDocs.Shared.Api
@using HomelabDocs.Shared.Containers
@using HomelabDocs.Web.Components.Diagram
@using HomelabDocs.Web.Models
@inject IHomelabDocsApi HomelabDocsApi

<PageTitle>HomelabDocs</PageTitle>

<div class="app-page">
    <header class="app-bar">
        <div class="app-bar-brand">
            <h1 class="app-bar-title">HomelabDocs</h1>
            <p class="app-bar-subtitle">Infrastructure visualization</p>
        </div>
        <div class="app-bar-actions">
            <button type="button"
                    class="refresh-button"
                    disabled="@_isLoading"
                    @onclick="RefreshContainersAsync">
                Refresh containers
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="status-banner @_statusBannerClass" role="status">
            <span>@_statusMessage</span>
            @if (_hasError)
            {
                <button type="button"
                        class="refresh-button refresh-button-inline"
                        disabled="@_isLoading"
                        @onclick="RefreshContainersAsync">
                    Retry
                </button>
            }
        </div>
    }

    <main class="diagram-canvas">
        @if (_graph is not null)
        {
            <CytoscapeDiagram Graph="_graph" />
        }
    </main>
</div>

@code {
    private DiagramGraph? _graph;
    private string? _statusMessage;
    private string _statusBannerClass = "status-banner-info";
    private bool _isLoading;
    private bool _hasError;

    protected override async Task OnInitializedAsync()
    {
        await LoadContainersAsync();
    }

    private async Task RefreshContainersAsync()
    {
        await LoadContainersAsync();
    }

    private async Task LoadContainersAsync()
    {
        _isLoading = true;
        _hasError = false;
        _statusMessage = "Loading containers…";
        _statusBannerClass = "status-banner-info";

        try
        {
            var response = await HomelabDocsApi.GetRunningContainersAsync();
            var containers = response.Containers.ToList();
            _graph = ToDiagramGraph(containers);

            if (containers.Count == 0)
            {
                _statusMessage = "No running containers were found.";
                _statusBannerClass = "status-banner-info";
            }
            else
            {
                _statusMessage = null;
            }
        }
        catch (Exception)
        {
            _hasError = true;
            _statusMessage =
                "Unable to load containers. Confirm that Docker is running and that the API can access the Docker socket.";
            _statusBannerClass = "status-banner-error";
            _graph ??= new DiagramGraph([], []);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static DiagramGraph ToDiagramGraph(IReadOnlyList<ContainerResponse> containers)
    {
        var nodes = containers
            .Select(container => new DiagramNode(
                container.Id,
                container.Name,
                "container",
                container.State))
            .ToArray();

        return new DiagramGraph(nodes, []);
    }
}
